[FORMAT]
max-line-length = 120

[DESIGN]
max-args=10
max-positional-arguments=10
max-branches=20

[TYPECHECK]
ignored-modules=cv2

[MESSAGES CONTROL]
disable =
    invalid-name,
    unused-argument,
    too-many-locals,
    too-many-statements,
    too-few-public-methods,
    import-error,
    duplicate-code,
    missing-function-docstring,
    missing-class-docstring,
    missing-module-docstring,
    consider-using-from-import,
    too-many-arguments,
    too-many-locals,
    too-many-instance-attributes,
    unnecessary-ellipsis
